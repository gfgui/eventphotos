// Data model: see "Modelo de dados" in docs/especificacao-tecnica.md.
// Models and fields are in English; tables and columns are snake_case so hand-written SQL
// (NOTIFY triggers, ranking queries, pg-boss) stays readable.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ModerationMode {
  HIDE_AFTER // published right away; hosts can hide it later
  APPROVE_FIRST // hosts approve each upload before it is published

  @@map("moderation_mode")
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED

  @@map("event_status")
}

enum MediaType {
  PHOTO
  VIDEO

  @@map("media_type")
}

enum MediaSource {
  CAMERA
  GALLERY

  @@map("media_source")
}

enum MediaStatus {
  UPLOADING // upload URL issued, file not confirmed yet
  PROCESSING // waiting for the worker: thumbnail, display version and hash
  PENDING_APPROVAL // processed, waiting for a host (APPROVE_FIRST)
  PUBLISHED
  HIDDEN // hidden by a host
  FAILED // the worker could not process the file

  @@map("media_status")
}

model Host {
  id           String      @id @default(uuid(7)) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  events       EventHost[]

  @@map("hosts")
}

/// An event can have more than one host.
model EventHost {
  eventId   String   @map("event_id") @db.Uuid
  hostId    String   @map("host_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@id([eventId, hostId])
  @@index([hostId])
  @@map("event_hosts")
}

model Event {
  id                    String         @id @default(uuid(7)) @db.Uuid
  slug                  String         @unique
  name                  String
  date                  DateTime       @db.Timestamptz(3)
  coverKey              String?        @map("cover_key")
  /// Colors, font and feed style. Validated with Zod before saving.
  appearance            Json           @default("{}")
  likesRankingEnabled   Boolean        @default(true) @map("likes_ranking_enabled")
  uploadsRankingEnabled Boolean        @default(true) @map("uploads_ranking_enabled")
  moderationMode        ModerationMode @default(HIDE_AFTER) @map("moderation_mode")
  status                EventStatus    @default(DRAFT)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  hosts                 EventHost[]
  roles                 Role[]
  guests                Guest[]
  media                 Media[]

  @@map("events")
}

model Role {
  id      String  @id @default(uuid(7)) @db.Uuid
  eventId String  @map("event_id") @db.Uuid
  name    String
  order   Int     @map("sort_order")
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests  Guest[]

  @@unique([eventId, name])
  // Target of Guest's composite foreign key.
  @@unique([id, eventId])
  @@map("roles")
}

model Guest {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  name      String
  /// Bundled avatar reference, such as "casual/12".
  avatar    String
  /// SHA-256 of the token kept in the guest's cookie.
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Keyed on (roleId, eventId) so the role must belong to the guest's event.
  // NoAction (checked at the end of the statement) blocks deleting a role in use,
  // but still lets an event delete cascade to its roles and guests together.
  role      Role     @relation(fields: [roleId, eventId], references: [id, eventId], onDelete: NoAction)
  media     Media[]
  likes     Like[]

  @@unique([id, eventId]) // target of Media's composite foreign key
  @@index([eventId])
  @@index([roleId])
  @@map("guests")
}

model Media {
  id           String      @id @default(uuid(7)) @db.Uuid
  eventId      String      @map("event_id") @db.Uuid
  guestId      String      @map("guest_id") @db.Uuid
  type         MediaType   @default(PHOTO)
  source       MediaSource
  /// The original is stored as uploaded and never modified or recompressed.
  originalKey  String      @unique @map("original_key")
  /// Display and thumbnail versions are created by the worker, without EXIF.
  displayKey   String?     @map("display_key")
  thumbnailKey String?     @map("thumbnail_key")
  /// Filter name, applied with CSS on display; the file itself is never filtered.
  filter       String?
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  width        Int?
  height       Int?
  sha256       String?
  /// Capture date read from EXIF.
  capturedAt   DateTime?   @map("captured_at") @db.Timestamptz(3)
  status       MediaStatus @default(UPLOADING)
  likeCount    Int         @default(0) @map("like_count")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Keyed on (guestId, eventId) so the author must belong to the media's event.
  guest        Guest       @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: Cascade)
  likes        Like[]

  @@index([eventId, status, likeCount(sort: Desc)])
  @@index([eventId, status, createdAt(sort: Desc)])
  @@index([guestId])
  @@map("media")
}

/// The composite key allows one like per guest on each media.
model Like {
  mediaId   String   @map("media_id") @db.Uuid
  guestId   String   @map("guest_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([mediaId, guestId])
  @@index([guestId])
  @@map("likes")
}
