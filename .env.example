# Copy to .env and fill in. The .env file is read by Next.js, Prisma and docker-compose.

# local (the host's notebook, without internet) or cloud
DEPLOY_MODE=local
# Address in the QR Code. At the event, use the notebook's fixed IP, such as http://192.168.0.10:3000
# In local mode, phones also upload to Garage at this host, and its CORS only accepts this origin.
PUBLIC_URL=http://localhost:3000

# Asked for once, when the first admin account is created at /admin. Without it, anyone on
# the network could create that account first.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_CODE=

# Postgres in docker-compose. DATABASE_URL repeats the user, password and database.
POSTGRES_DB=photos
POSTGRES_USER=photos
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://photos:change-this-password@localhost:5432/photos

# S3-compatible storage. On Amazon S3, leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:3900
# On Garage, must match s3_region in garage/garage.toml.
S3_REGION=garage
S3_BUCKET=media
S3_FORCE_PATH_STYLE=true
# On Garage, the key ID is "GK" followed by 24 hex characters, and the secret has 64.
# Generate with: node -e "const c=require('crypto');console.log('GK'+c.randomBytes(12).toString('hex'));console.log(c.randomBytes(32).toString('hex'))"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Used only by Garage in docker-compose: 64 hex characters each.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
